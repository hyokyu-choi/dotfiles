//
// Waybar modules config

{
    "custom/kernel": {
        "format": "<span foreground='#c6089e'></span> {}",
	      "max-length": 15,
        "interval": 3600,
        "exec": "uname -r"
    },

    "hyprland/workspaces": {
        "format": "<span background='#1a1d25'>{icon} {name}</span>",
        "format-icons": {
            "1": "",
            "2": " ",
            "3": "🗗 ",
            "4": " ",
	          "5": " ",
            "6": "✉ ",
            "7": " ",
            "8": "",
            "urgent": "",
            "active": "",
            "default": ""
        },
        "sort-by-number": true,
	      "on-scroll-up": "hyperctl dispatch workspace e+1",
	      "on-scroll-down": "hyperctl dispatch workspace e-1",
	      "on-click": "activate"
    },

    "custom/pacman": {
        "format": "{} <span foreground='#000000'> </span>",
        "interval": 60,
        "exec": "checkupdates | wc -l",
        "exec-if": "exit 0",
        "signal": 8
    },

    "custom/media": {
        "format": "{icon}{text}",
	      "escape": true,
	      "return-type": "json",
        "max-length": 35,
        "exec": "$HOME/.config/waybar/scripts/mediaplayer.py 2> /dev/null"
    },

    "custom/dunst": {
    	  "exec": "$HOME/.config/waybar/scripts/dunst.sh",
	      "on-click": "dunstctl set-paused toggle",
    	  "restart-interval": 1,
	      "return-type": "json",
	      "max-length": 10,
	      "signal": 8,
	      "format": "<span foreground='#928374'></span>{}"
    },

    "clock": {
        "interval": 1,
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "<span foreground='#000000'></span>  {:%a, %d %b // %H:%M:%S}"
    },

    "cpu": {
        "interval": 1,
        "format": "<span foreground='#000000'> </span>{icon} {usage}%",
        "format-alt": "{icon0}{icon1}{icon2}{icon3}{icon4}{icon5}",
	    "format-icons": [
          "<span color='#69ff94'>▁</span>",
          "<span color='#69ff94'>▂</span>",
          "<span color='#ffa500'>▄</span>",
          "<span color='#ffa500'>▅</span>",
          "<span color='#dd532e'>▆</span>", 
          "<span color='#dd532e'>▇</span>"
     ]
    },

    "memory": {
	    "interval": 1,
        "format": "<span foreground='#000000'> </span>{icon} {percentage}%",
        "format-alt": "{icon0}{icon1}{icon2}{icon3}{icon4}{icon5}",
	    "format-icons": [
          "<span color='#69ff94'>▁</span>",
          "<span color='#69ff94'>▂</span>",
          "<span color='#ffa500'>▄</span>",
          "<span color='#ffa500'>▅</span>",
          "<span color='#dd532e'>▆</span>", 
          "<span color='#dd532e'>▇</span>"
     ]
    },

    "disk": {
	    "interval": 30,
	    "path": "/",
        "format": "<span foreground='#000000'></span> {percentage_used}%",
        "states": {
            "warning": 70,
            "critical": 90
        }
    },

    "backlight": {
        "format": "<span foreground='#000000'>{icon}</span> {percent}%",
        "format-icons":  ["",""]
    },


    "battery": {
    	"full-at": 100,
    	"interval": 5,
    	"states": {
          "warning": 30,
          "critical": 10
    	},
    	"format": "<span foreground='#000000'> </span>{icon} {capacity}%",
	    "format-charging": "<span foreground='#000000'></span> {icon}{capacity}%",
	    "format-icons": [
          "<span color='#ff005c'></span>",
          "<span color='#e67500'></span>", 
          "<span color='#9affcc'></span>",
          "<span color='#9affcc'></span>",
          "<span color='#9affcc'></span>",
	]
    },

    "network": {
        "interval": 5,
        "interface": "wlan0",
        "format-wifi": "<span foreground='#000000'>   {essid}</span>",
        "format-ethernet": "<span foreground='#000000'>⮔ {ipaddr}/{cidr}</span>",
        "format-linked": "<span foreground='#000000'>⚡{ifname}</span>",
        "format-disconnected": "<span foreground='#000000'>⚡Disconnected</span>",
        "tooltip-format": "{ifname}: {essid}/{cidr}\n {bandwidthDownBits}\n {bandwidthUpBits}"
    },

    "custom/vpn": {
    	"format": "{}",
    	"exec": "$HOME/.config/waybar/scripts/vpn.py",
	    "return-type": "json",
    	"interval": 5,
	    "max-length": 5
    },

    "pulseaudio": {
        "format": "<span foreground='#000000'>{icon}</span>   {volume}% {format_source}",
        "format-muted": "<span foreground='#000000'></span> {format_source}",
        "format-source": "<span foreground='#000000'></span> {volume}%",
        "format-source-muted": "<span foreground='#000000'></span>",
        "format-icons": {
            "headphone": "",
            "phone": "",
            "default": ["", ""]
        },
        "on-click": "pavucontrol",
        "on-click-right": "env LIBGL_ALWAYS_SOFTWARE=1 helvum"
    },

    "bluetooth": {
	    "format": "<span foreground='#000000'></span> {status}",
	    "format-connected": "<span foreground='#000000'></span> {device_alias}",
	    "format-connected-battery": "<span foreground='#000000'></span> {device_alias} {device_battery_percentage}%",
	    // "format-device-preference": [ "device1", "device2" ], // preference list deciding the displayed device
	    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
	    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
	    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
	    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%"
    },

}


